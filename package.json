{
  "name": "resolveai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix client install --include=dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "seed": "npm --prefix server run seed",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
