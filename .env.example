# ==========================================
# ResolveAI - Vercel Production Environment
# ==========================================

# Server-Side Variables (Configured in Vercel Project Settings)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resolveai?retryWrites=true&w=majority
JWT_SECRET=your_secure_random_jwt_secret_here
GEMINI_API_KEY=your_google_gemini_api_key_here
NODE_ENV=production

# Client-Side Variables (Optional - defaults to same-origin /api)
VITE_API_URL=/api
